colorClear() {
    echo "\[\]"
}

colorToken() {
    color=$1
    text=$2
    echo "\[\e[38;5;${color}m\]${text}\[\]"
}

colorPrompt() {
    historyColor=${1:-196}
    hostColor=${2:-208}
    dirColor=${3:-226}
    cmdLineColor=${4:-$(echo $(( (hostColor + dirColor) % 256 )))}
    hist="$(colorToken $historyColor \\!)"
    host="$(colorToken $hostColor \\h)"
    dir="$(colorToken $dirColor '<\w> ')"
    cmdLine="$(colorToken $cmdLineColor '')"
    export PS1="${hist} ${host} ${dir} $cmdLine"
}

# Choose a random line from ~/.hidden/.favoriteColor
# Example line: colorBG 250 250 209; colorPrompt 40 82 84 229
# line=$(shuf -n1 ~/.hidden/.favoriteColors)
# bg=$(echo $line | cut -d ';' -f1)
# fg=$(echo $line | cut -d ';' -f2)

bg=$(shuf -n1 ~/.hidden/.favoriteBGs)
fg=$(shuf -n1 ~/.hidden/.favoriteFGs)

echo colorBG $bg
colorBG $bg

echo colorPrompt $fg
colorPrompt $fg

