#!/bin/bash

# Set terminal background color (your original function)
colorBG() {
    local r=${1:-FF}
    local g=${2:-FF} 
    local b=${3:-FF}
    echo -e "\e]11;rgb:$r/$g/$b\a"
}

# Set terminal foreground/text color
colorFG() {
    local r=${1:-00}
    local g=${2:-00}
    local b=${3:-00}
    echo -e "\e]10;rgb:$r/$g/$b\a"
}

# Enhanced version with validation
colorBGSafe() {
    local r=${1:-FF}
    local g=${2:-FF}
    local b=${3:-FF}
    
    # Validate hex values
    if [[ ! "$r" =~ ^[0-9A-Fa-f]{2}$ ]] || 
       [[ ! "$g" =~ ^[0-9A-Fa-f]{2}$ ]] || 
       [[ ! "$b" =~ ^[0-9A-Fa-f]{2}$ ]]; then
        echo "Error: RGB values must be 2-digit hex (00-FF)" >&2
        return 1
    fi
    
    printf "\e]11;rgb:%s/%s/%s\a" "$r" "$g" "$b"
}

# Convert decimal RGB (0-255) to hex for terminal
colorBGDec() {
    local r=${1:-255}
    local g=${2:-255}
    local b=${3:-255}
    
    # Convert to hex with leading zeros
    local rhex=$(printf "%02X" "$r")
    local ghex=$(printf "%02X" "$g") 
    local bhex=$(printf "%02X" "$b")
    
    printf "\e]11;rgb:%s/%s/%s\a" "$rhex" "$ghex" "$bhex"
}

# Preset background colors
colorBGRed()     { colorBG "FF" "00" "00"; }
colorBGGreen()   { colorBG "00" "FF" "00"; }
colorBGBlue()    { colorBG "00" "00" "FF"; }
colorBGBlack()   { colorBG "00" "00" "00"; }
colorBGWhite()   { colorBG "FF" "FF" "FF"; }
colorBGGray()    { colorBG "80" "80" "80"; }
colorBGDark()    { colorBG "1A" "1A" "1A"; }  # Dark gray

# Reset to terminal default colors
colorReset() {
    # Reset background to default
    echo -e "\e]111\a"
    # Reset foreground to default  
    echo -e "\e]110\a"
}

# Save current colors (if terminal supports it)
colorSave() {
    echo -e "\e]11;?\a"  # Query current background
    echo -e "\e]10;?\a"  # Query current foreground
}

# Popular color schemes
colorSchemeDark() {
    colorBG "1A" "1A" "1A"  # Dark background
    colorFG "E0" "E0" "E0"  # Light text
}

colorSchemeMatrix() {
    colorBG "00" "00" "00"  # Black background
    colorFG "00" "FF" "00"  # Green text
}

colorSchemeTerminal() {
    colorBG "00" "00" "00"  # Black background
    colorFG "C0" "C0" "C0"  # Light gray text
}

# Example usage function
showColorExamples() {
    echo "Terminal Color Functions Demo:"
    echo "Current colors:"
    
    echo "Setting red background..."
    colorBGRed
    sleep 1
    
    echo "Setting green background..." 
    colorBGGreen
    sleep 1
    
    echo "Setting dark theme..."
    colorSchemeDark
    sleep 2
    
    echo "Resetting to defaults..."
    colorReset
}

# Usage examples:
# colorBG FF 00 00           # Red background (hex)
# colorBGDec 255 0 0         # Red background (decimal)  
# colorBGRed                 # Preset red
# colorSchemeDark            # Dark theme
# colorReset                 # Reset to defaults
