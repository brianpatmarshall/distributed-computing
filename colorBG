   colorLs 170 127 218        # dirs orchid, links magenta, execs pale rose
}

colorDeepGrayGraphite() {
   colorBG 12 12 14           # graphite — achromatic but for a faint B lift that
                              # keeps it from going flat.  The strictest reading of
                              # the rule: no hue left to vary, only brightness
   colorPrompt 238 244 250 255 # charcoal -> slate -> silver -> near-white
   colorLs 250 244 255        # dirs silver, links slate, execs near-white
}

# ============================================================================
# Scheme names follow color<Tier><Hue><Name>:
#   Tier — Deep (BG max channel <= 0x14), Dark (0x15-0x21), Pale (0x22+),
#          Soft (a Pale BG with a muted prompt),
#          Pastel (a Dark BG with a pastel prompt)
#   Hue  — Green, Teal, Blue, Purple, Red, Gray — from the BG, not
#          the prompt
# Old names below are kept as one-line aliases.
# ============================================================================
