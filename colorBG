}

colorDarkRedRacing() {
   colorBG 1E 00 00           # Rosso Corsa (#D40000) — Italy's racing red, and the
                              # third of the motorsport trio with BRG and French
                              # Racing Blue.  Pure R with no lift at all, which is
                              # the color's actual signature
   colorPrompt 88 124 160 217 # every rung on the pure-red axis, brightness only
   colorLs 160 124 217        # dirs Rosso Corsa, links deep red, execs pale pink
}

