# ============================================================================
# Matched-hue schemes — BG and prompt share one hue family.  The BG is a
# dark version of the prompt's own hue, so nothing on screen fights anything
# else; the ladder carries all contrast.
# Modeled on the reference pair `colorBG 06 0C 21; colorPrompt 28 41 154 157`
# — dominant channel around 0x21, ladder climbing dim -> bright -> pale.
# ============================================================================

# --- Dark green family ---

colorDarkGreenMoss() {
   colorBG 0E 21 0A           # moss — G dominant with an R lift (yellow-green),
                              # B kept lowest so it reads mossy, not teal
   colorPrompt 28 41 154 157  # dark green -> spring green -> yellow-green -> pale green
   colorLs 154 41 157         # dirs yellow-green, links spring green, execs pale green
}

colorDarkGreenSpinach() {
   colorBG 06 21 14           # spinach — G dominant with a B lift (blue-green),
                              # R lowest for a deeper, cooler leaf tone
   colorPrompt 22 35 78 157   # dark green -> sea green -> bright sea green -> pale green
   colorLs 78 35 157          # dirs bright sea green, links sea green, execs pale green
}

colorDarkGreenRacing() {
   colorBG 00 1A 0F           # British Racing Green (#004225) held at its true hue
                              # ratio — the darkest of this family.  R=0 is the BRG
                              # signature; B at ~half G gives the teal lift
   colorPrompt 29 36 42 158   # racing green -> jade -> bright jade -> pale mint
   colorLs 42 36 158          # dirs bright jade, links jade, execs pale mint
}

# Spinach variations — same prompt as colorDarkGreenSpinach, BG dropped to a
# G of 0x16 and the B lift stepped up across the three: pure dark green ->
# hint of blue -> blue nearly level with green.

colorDarkGreenCollard() {
   colorBG 04 16 0A           # collard — darker than Spinach with the B lift
                              # trimmed, so it reads as plain deep green
   colorPrompt 22 35 78 157
   colorLs 78 35 157
}

colorDarkGreenKale() {
   colorBG 04 16 10           # kale — darker green with a hint of blue, the
                              # dusty blue-green of a kale leaf
   colorPrompt 22 35 78 157
   colorLs 78 35 157
}

colorDarkGreenSeaKale() {
   colorBG 04 16 15           # sea kale — B almost level with G, the glaucous
                              # blue-green of the coastal plant.  Still just
                              # green-dominant; B = G would be Verdigris teal
   colorPrompt 22 35 78 157
   colorLs 78 35 157
}

# --- Dark blue family ---
# Structural translations of the three greens above: the dominant channel
# moves G -> B, and each green's secondary lift moves with it.  Moss leans
# warm off green, so Indigo leans warm (violet) off blue; Spinach and Racing
# lean cool off green, so Prussian and Racing lean cool (teal) off blue.

colorDarkBlueIndigo() {
   colorBG 0E 0A 21           # indigo — B dominant with an R lift (violet-leaning),
                              # G lowest.  Muted, the way moss is muted
   colorPrompt 19 26 99 147   # deep blue -> azure -> periwinkle -> pale periwinkle
   colorLs 99 26 147          # dirs periwinkle, links azure, execs pale periwinkle
}

colorDarkBluePrussian() {
   colorBG 06 14 21           # Prussian (#003153) — B dominant with a G lift
                              # (teal-leaning), R lowest for a deeper, cooler tone
   colorPrompt 18 25 68 147   # navy -> steel blue -> light steel -> pale periwinkle
   colorLs 68 25 147          # dirs light steel, links steel blue, execs pale periwinkle
}

# Prussian variations — mirror the Spinach variations with G and B swapped.
# Same prompt as colorDarkBluePrussian, BG dropped to a B of 0x16 and the G
# lift stepped up across them: pure dark blue -> hint of green -> more green
# (Lagoon) -> green nearly level with blue.

colorDarkBlueSapphire() {
   colorBG 04 0A 16           # sapphire — darker than Prussian with the G lift
