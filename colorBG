   colorPrompt 24 31 32 153   # racing blue -> cerulean -> bright cerulean -> pale sky
   colorLs 32 31 153          # dirs bright cerulean, links cerulean, execs pale sky
}

# --- Dark red family ---
# Same three-way split again: one warm-lift, one cool-lift, one named paint.
# Rust and Burgundy both lean on B over G — any real G lift at this darkness
# turns red to brown.
# Reds run at a slightly higher dominant (0x1E) than the greens and blues
# because red carries about a third of green's perceived luminance at the
# same channel value — 1E 00 00 still reads darker than 00 1A 0F.

colorDarkRedRust() {
   colorBG 1E 02 0C           # rust — R dominant, B lift over a trace of G.  The
                              # G trace keeps a hint of ember warmth; B carries
                              # the rest so it reads red, not brown
   colorPrompt 94 130 172 223 # dark amber -> ember -> bright amber -> pale peach
   colorLs 172 130 223        # dirs bright amber, links ember, execs pale peach
}

colorDarkRedBurgundy() {
   colorBG 1E 00 18           # burgundy — R dominant with a strong B lift
                              # (wine-leaning), G at zero for a cooler, deeper tone
   colorPrompt 52 125 168 217 # dark maroon -> wine -> rose -> pale pink
   colorLs 168 125 217        # dirs rose, links wine, execs pale pink
}

# Burgundy variations — the red counterpart to the Spinach and Prussian
# variations.  Same prompt as colorDarkRedBurgundy, BG at an R of 0x1A with
# G at zero, and the B lift stepped up across the three: deep red ->
# hint of blue -> blue nearly level with red.  G is zero throughout: at
# this darkness any G plus a low R reads as brown rather than red.

colorDarkRedOxblood() {
   colorBG 1A 00 08           # oxblood — G at zero and R up for saturation, with
                              # a small B lift that keeps it deep red, not brown
   colorPrompt 52 125 168 217
   colorLs 168 125 217
}

colorDarkRedMulberry() {
