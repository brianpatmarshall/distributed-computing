# --- OSC color query helpers ---
# Send an OSC ?-query and capture the terminal's response.  The response
# arrives as input on /dev/tty, so we have to put the line discipline in
# raw, no-echo mode to read it cleanly — otherwise the terminal buffers
# the bytes (canonical mode waits for newline) or echoes them on screen.
#
# Usage internally:  _queryColorOSC 11   (BG)
#                    _queryColorOSC 10   (FG)
# Prints "RR GG BB" hex on stdout, returns 0 on success.
_queryColorOSC() {
    local osc=$1 response old_stty

    if ! old_stty=$(stty -g </dev/tty 2>/dev/null); then
        echo "_queryColorOSC: not running on a terminal" >&2
        return 1
    fi

    # min 0 time 5 = read-with-timeout, 0.5s; -icanon -echo = raw mode.
    stty -icanon -echo min 0 time 5 </dev/tty
    printf '\e]%s;?\a' "$osc" >/dev/tty
    response=$(head -c 64 </dev/tty)
    stty "$old_stty" </dev/tty

    if [[ $response =~ rgb:([0-9a-fA-F]+)/([0-9a-fA-F]+)/([0-9a-fA-F]+) ]]; then
        local r=${BASH_REMATCH[1]} g=${BASH_REMATCH[2]} b=${BASH_REMATCH[3]}
        # xterm-family responds with 4 hex digits per channel (16-bit
        # scaled).  Take the high byte for normal 8-bit values.
        (( ${#r} == 4 )) && { r=${r:0:2}; g=${g:0:2}; b=${b:0:2}; }
        printf '%s %s %s\n' "$r" "$g" "$b"
        return 0
    fi

    echo "_queryColorOSC: no/invalid response (got: ${response@Q})" >&2
    return 1
}

# Print current BG / FG as "RR GG BB" hex.
queryBG() { _queryColorOSC 11; }
queryFG() { _queryColorOSC 10; }

# Same as queryBG/queryFG but in decimal.
queryBGDec() {
    local rgb r g b
    rgb=$(_queryColorOSC 11) || return 1
    read -r r g b <<< "$rgb"
    printf '%d %d %d\n' "$((16#$r))" "$((16#$g))" "$((16#$b))"
}
queryFGDec() {
    local rgb r g b
    rgb=$(_queryColorOSC 10) || return 1
    read -r r g b <<< "$rgb"
    printf '%d %d %d\n' "$((16#$r))" "$((16#$g))" "$((16#$b))"
}

# Show both — the convenience function.
colorSave() {
    local bg fg
    bg=$(queryBG) && echo "BG: $bg"
    fg=$(queryFG) && echo "FG: $fg"
}

