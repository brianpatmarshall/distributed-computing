#!/bin/bash

# Set terminal background color (your original function)
colorBG() {
   local r=${1:-FF}
   local g=${2:-FF} 
   local b=${3:-FF}
   echo -e "\e]11;rgb:$r/$g/$b\a"
}

# Set terminal foreground/text color
colorFG() {
   local r=${1:-00}
   local g=${2:-00}
   local b=${3:-00}
   echo -e "\e]10;rgb:$r/$g/$b\a"
}

# Enhanced version with validation
colorBGSafe() {
   local r=${1:-FF}
   local g=${2:-FF}
   local b=${3:-FF}
   
   # Validate hex values
   if [[ ! "$r" =~ ^[0-9A-Fa-f]{2}$ ]] || 
      [[ ! "$g" =~ ^[0-9A-Fa-f]{2}$ ]] || 
      [[ ! "$b" =~ ^[0-9A-Fa-f]{2}$ ]]; then
       echo "Error: RGB values must be 2-digit hex (00-FF)" >&2
       return 1
   fi
   
   printf "\e]11;rgb:%s/%s/%s\a" "$r" "$g" "$b"
}

# Convert a single decimal value (0-255) to 2-digit hex
dec2hex() {
   printf "%02X" "$1"
}

# Set background using decimal RGB (0-255)
colorBGDec() {
   local r=${1:-255}
   local g=${2:-255}
   local b=${3:-255}

   colorBG "$(dec2hex "$r")" "$(dec2hex "$g")" "$(dec2hex "$b")"
}

# Set LS_COLORS so ls output stays in the same family as the active scheme.
# Args: di-color, ln-color, ex-color (256-color cube indices).
# Each color* scheme below calls this to keep ls in family.
colorLs() {
    local di=$1 ln=$2 ex=$3
    export LS_COLORS="di=01;38;5;${di}:ln=01;38;5;${ln}:ex=01;38;5;${ex}"
}

